/* pages/mine/mine.wxss —— 我的样式（暖暮治愈主题） */
.page {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, var(--brand-soft), var(--brand));
  color: #ffffff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.cell {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.cell-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.cell-main {
  flex: 1;
}

.cell-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.cell-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.cell-arrow {
  font-size: 36rpx;
  color: var(--text-3);
}

.group-title {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 8rpx 8rpx 16rpx;
}

.hotline {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 26rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.hotline-main {
  flex: 1;
}

.hotline-name {
  font-size: 30rpx;
  color: var(--text);
}

.hotline-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.hotline-phone {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.version {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
