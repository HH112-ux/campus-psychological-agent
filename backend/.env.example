# ===== 心屿后端环境变量模板 =====
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁提交。

# 应用
APP_NAME=xinyu-backend
APP_VERSION=0.1.0
ENV=dev
DEBUG=false

# MongoDB（本地原生 mongod 或 docker-compose mongo 服务）
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=xinyu

# JWT（P1 启用前必须替换为随机强密钥：openssl rand -hex 32）
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=604800
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# 对话内容加密（P4 启用；密钥与数据库分离托管）
DATA_ENCRYPTION_KEY=

# 微信小程序（P1 登录）
WX_APPID=wx你的小程序AppID
# AppSecret 仅存服务端；本地开发无 Secret 时保持 WX_MOCK_LOGIN=true 走 mock
WX_SECRET=
WX_MOCK_LOGIN=true
WX_MOCK_OPENID=mock_dev_openid

# 业务规则（P1）
MESSAGE_MAX_LENGTH=2000
SESSION_ROUND_LIMIT=50
SESSION_CONCURRENCY_LIMIT=3
MEMORY_WINDOW_ROUNDS=20

# 数据留存与清除（M3）：软删恢复期 + 到期物理删除定时任务
# 软删后用户可撤销的天数（期限口径待 M2 与校方确认）
ERASE_RECOVER_DAYS=30
# 生产必须为 true，否则「软删 N 天后物理删除」的合规承诺不兑现
DATA_PURGE_ENABLED=true
# 到期数据扫描间隔（秒），默认每小时一次
DATA_PURGE_INTERVAL_SECONDS=3600

# 智谱开放平台（https://open.bigmodel.cn 申请）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_CHAT=glm-4-air
MODEL_LIGHT=glm-4-flash

# 限流与降级
USER_MESSAGE_HOURLY_LIMIT=30
MODEL_TIMEOUT_SECONDS=30.0

# 情绪分析（P3）：单轮分析硬超时（秒），超过即跳过本轮记录
EMOTION_ANALYSIS_TIMEOUT_SECONDS=5.0

# P5 降级开关：false 时跳过情绪分析（不调模型/不写记录/不发 emotion 事件）
EMOTION_ANALYSIS_ENABLED=true
# P5 降级开关：false 时对话统一走非流式 JSON（弱网/平台异常兜底）
STREAM_ENABLED=true
