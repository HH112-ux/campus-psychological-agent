/* pages/chat/chat.wxss —— 对话页样式（暖暮治愈主题） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}
.msg-scroll {
  flex: 1;
  min-height: 0;
}
.msg-inner {
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}
.inline-card {
  margin: 8rpx 0 8rpx 88rpx;
}

/* 气泡行 */
.row {
  display: flex;
  margin: 22rpx 0;
  align-items: flex-start;
}
.row--user {
  justify-content: flex-end;
}
.row--ai {
  justify-content: flex-start;
}
/* 小屿头像：屿青渐变，安静不抢戏 */
.avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--brand-soft));
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
  word-break: break-word;
}
.bubble-text {
  white-space: pre-wrap;
}
/* 用户气泡：主色屿青底色，温和不刺眼 */
.bubble--user {
  background: var(--brand);
  color: #fff;
  border-top-right-radius: 8rpx;
}
.bubble--ai {
  background: var(--surface);
  color: var(--text);
  border-top-left-radius: 8rpx;
  box-shadow: var(--shadow-soft);
}
.bubble--hint {
  color: var(--text-3);
  font-size: 27rpx;
}
.degraded {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--accent-ink);
}

/* 情绪识别角标 —— 语义色，需与主色区分，不可被暖底洗掉 */
.emotion-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: var(--input-bg);
  color: var(--text-2);
}
.emotion-badge--red {
  background: var(--danger-tint);
  color: var(--danger);
}
.emotion-badge--blue {
  background: var(--info-tint);
  color: var(--info);
}
.emotion-badge--green {
  background: var(--success-tint);
  color: var(--success);
}
.emotion-badge--orange {
  background: var(--warn-tint);
  color: var(--warn);
}
.emotion-badge--gray {
  background: var(--input-bg);
  color: var(--text-2);
}

/* 正在输入动画 */
.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}
.typing .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  animation: blink 1.2s infinite ease-in-out;
}
.typing .dot:nth-child(2) {
  animation-delay: 0.2s;
}
.typing .dot:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* 输入区 */
.composer {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 2rpx solid var(--line);
}
.composer-box {
  flex: 1;
  background: var(--input-bg);
  border-radius: var(--radius-md);
  padding: 16rpx 22rpx;
  box-sizing: border-box;
}
.composer-input {
  width: 100%;
  max-height: 200rpx;
  min-height: 44rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--text);
}
.composer-ph {
  color: var(--text-3);
}
.composer-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 4rpx;
}
.word-count {
  font-size: 22rpx;
  color: var(--text-3);
}
.word-count--over {
  color: var(--danger);
}
.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 36rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn--disabled {
  background: var(--disabled);
  color: #f2f7f5;
}

/* V5 语音输入：麦克风按钮（录音中为红色计时，转写中为灰底） */
.mic-btn {
  flex-shrink: 0;
  height: 72rpx;
  min-width: 72rpx;
  padding: 0 18rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mic-btn--rec {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
  font-size: 26rpx;
}
.mic-btn--busy {
  background: var(--disabled);
  border-color: var(--disabled);
  color: #fff;
  font-size: 24rpx;
}
