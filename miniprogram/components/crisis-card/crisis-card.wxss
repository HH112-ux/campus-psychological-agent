/* components/crisis-card/crisis-card.wxss
   危机卡片 —— 安全功能，语义强度不可被主题弱化。
   仅做「色相微暖 + 圆角统一」的协调，保留红/琥珀的醒目度与相互区分度。
   组件内使用字面色值，避免依赖全局变量继承（样式隔离下更稳妥）。 */
.crisis-card {
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  margin: 16rpx 0;
  box-sizing: border-box;
}
/* 高危：警示红系，保持最高醒目度 */
.crisis-card--high {
  background: linear-gradient(135deg, #fdf0ec 0%, #fbe0d8 100%);
  border: 2rpx solid #f0af9e;
}
/* 中危：琥珀系，与红色明确区分 */
.crisis-card--mid {
  background: linear-gradient(135deg, #fdf8ee 0%, #fbeed3 100%);
  border: 2rpx solid #edd0a0;
}
.cc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cc-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.crisis-card--high .cc-badge {
  background: #c1342a;
  color: #fff;
}
.crisis-card--mid .cc-badge {
  background: #9c6218;
  color: #fff;
}
.cc-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8a7f78;
}
.cc-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2825;
}
.cc-subtitle {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #5e5852;
}
.cc-list {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 20rpx;
  overflow: hidden;
}
.cc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}
.cc-item + .cc-item {
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.cc-item-main {
  flex: 1;
  min-width: 0;
}
.cc-item-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #2b2825;
}
.cc-item-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8a7f78;
}
.cc-item-right {
  text-align: right;
  margin-left: 20rpx;
}
/* 求助电话：高危红，保证一眼可拨 */
.cc-phone {
  font-size: 28rpx;
  font-weight: 700;
  color: #c1342a;
  letter-spacing: 0.5rpx;
}
.cc-call {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #c1342a;
}
.cc-item--disabled {
  opacity: 0.55;
}
.cc-item--disabled .cc-phone,
.cc-item--disabled .cc-call {
  color: #a0958d;
}
.cc-foot {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a5548;
}
.cc-emergency {
  font-weight: 700;
  color: #c1342a;
}
