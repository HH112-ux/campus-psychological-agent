/* pages/practice/practice.wxss —— 练习页，全部使用 app.wxss 设计令牌，不持有字面色值 */
.page {
  padding: 32rpx 28rpx 60rpx;
}

.intro {
  font-size: var(--fs-body-s);
  color: var(--text-3);
  line-height: 1.6;
  margin: 8rpx 4rpx 28rpx;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  position: relative;
  padding: 30rpx 32rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.cat {
  font-size: var(--fs-caption);
  color: var(--brand);
  background: var(--brand-tint);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.dur {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.card-title {
  font-size: var(--fs-h2);
  color: var(--text);
  font-weight: 600;
}

.card-sub {
  margin-top: 8rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  line-height: 1.5;
}

.done-tag {
  position: absolute;
  top: 30rpx;
  right: 32rpx;
  font-size: var(--fs-micro);
  color: var(--accent-ink);
}

/* ---------- 练习面板 ---------- */

.mask {
  position: fixed;
  inset: 0;
  background: var(--scrim);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 20;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  text-align: center;
}

.sheet-title {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--text);
}

.sheet-sub {
  margin-top: 10rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
}

.breath-wrap {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, var(--brand-soft), var(--brand));
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform;
  transition-timing-function: ease-in-out;
  box-shadow: var(--shadow-brand);
}

.breath-text {
  color: #ffffff;
  font-size: var(--fs-h2);
  letter-spacing: 4rpx;
}

.mind-wrap {
  padding: 24rpx 0 8rpx;
}

.mind-step {
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  background: var(--surface);
  border-radius: var(--radius-sm);
  line-height: 1.5;
}

.mind-step.on {
  color: var(--text);
  background: var(--brand-tint);
  font-weight: 500;
}

.task-wrap {
  padding: 24rpx 0 8rpx;
}

.task {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  background: var(--surface);
  border-radius: var(--radius-sm);
}

.task.on {
  background: var(--brand-tint);
}

.tick {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: var(--fs-caption);
  text-align: center;
  line-height: 38rpx;
}

.task-text {
  font-size: var(--fs-body-s);
  color: var(--text);
}

/* 功能性例外：计时数字需在 220rpx 圆内远距离可读，保留 56rpx 大字号 */
.timer {
  text-align: center;
  margin: 24rpx 0 8rpx;
  font-size: 56rpx;
  font-weight: 600;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

.btns {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-main,
.btn-ghost {
  flex: 1;
  font-size: var(--fs-body);
  border-radius: var(--radius-md);
  line-height: 88rpx;
}

.btn-main {
  background: var(--brand);
  color: #ffffff;
}

.btn-ghost {
  background: var(--surface);
  color: var(--brand);
}
