/* pages/sessions/sessions.wxss —— 会话列表样式（暖暮治愈主题） */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.hero {
  padding: 24rpx 8rpx 32rpx;
}
.hero-title {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--brand-ink);
}
.hero-sub {
  margin-top: 16rpx;
  font-size: var(--fs-body-s);
  line-height: 1.7;
  color: var(--text-2);
}

.new-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--brand), var(--brand-soft));
  color: #fff;
  box-shadow: var(--shadow-brand);
}
.new-btn-plus {
  font-size: var(--fs-h2);
  line-height: 1;
}
.new-btn-text {
  font-size: var(--fs-h2);
  font-weight: 600;
}

.section-title {
  margin: 40rpx 8rpx 16rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-weight: 600;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 28rpx 26rpx;
  box-shadow: var(--shadow-soft);
}
.item-main {
  flex: 1;
  min-width: 0;
}
.item-title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-meta {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.item-time {
  margin-left: 6rpx;
}
.item-ops {
  display: flex;
  gap: 16rpx;
  margin-left: 16rpx;
}
.op {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--brand-ink);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
}
.op--danger {
  color: var(--danger);
  background: var(--danger-tint);
}

.empty {
  margin-top: 120rpx;
  text-align: center;
}
.empty-emoji {
  font-size: 72rpx;
}
.empty-text {
  margin-top: 20rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  padding: 0 60rpx;
  line-height: 1.7;
}

.privacy {
  margin-top: 80rpx;
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--text-3);
  line-height: 1.7;
  padding: 0 40rpx;
}
