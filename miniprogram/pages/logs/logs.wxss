/* pages/logs/logs.wxss —— 情绪日志样式（暖暮治愈主题） */
.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.trend-card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.trend-head {
  margin-bottom: 28rpx;
}

/* 连续记录：暖沙橘高光 */
.streak-badge {
  display: inline-block;
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--accent-ink);
  background: var(--accent-tint);
  border-radius: var(--radius-sm);
  padding: 6rpx 18rpx;
}

.streak-badge--dim {
  color: var(--text-3);
  background: var(--input-bg);
}

.trend-desc {
  margin-top: 18rpx;
  font-size: var(--fs-body);
  color: var(--text);
}

.trend-dom {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  flex: 1;
  width: 48rpx;
  display: flex;
  align-items: flex-end;
  background: var(--input-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

/* 柱状图：屿青渐变，像水位一样柔和地涨落 */
.bar {
  width: 100%;
  background: linear-gradient(180deg, var(--brand-soft), var(--brand));
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  min-height: 6rpx;
}

.bar--empty {
  background: var(--line);
  min-height: 8rpx;
}

.bar-label {
  margin-top: 10rpx;
  font-size: var(--fs-micro);
  color: var(--text-3);
}

.chart-legend {
  margin-top: 12rpx;
  font-size: var(--fs-micro);
  color: var(--text-3);
}

/* 本周小结（V2）：屿青淡染卡，文案来自服务端 */
.insight-card {
  background: var(--brand-tint);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 24rpx;
}

.insight-title {
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--brand-ink);
  margin-bottom: 16rpx;
}

.insight-line {
  font-size: var(--fs-body-s);
  color: var(--text);
  line-height: 1.6;
}

.insight-dot {
  color: var(--brand);
  margin-right: 10rpx;
}

.insight-range {
  margin-top: 14rpx;
  font-size: var(--fs-micro);
  color: var(--text-3);
}

.filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.chip {
  margin: 0 12rpx 16rpx 0;
  padding: 10rpx 28rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow-soft);
}

.chip--on {
  color: var(--brand-ink);
  background: var(--brand-tint);
  font-weight: 600;
}

.timeline {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 8rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.tl-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.tl-item:last-child {
  border-bottom: none;
}

.tl-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tl-main {
  flex: 1;
  min-width: 0;
}

.tl-head {
  display: flex;
  align-items: baseline;
}

.tl-label {
  font-size: 30rpx;
  font-weight: 600;
}

.tl-int {
  margin-left: 12rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.tl-time {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.tl-src {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.tl-evidence {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text);
  background: var(--input-bg);
  border-radius: var(--radius-sm);
  padding: 10rpx 16rpx;
  line-height: 1.5;
}

.tl-action {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--brand);
}

.empty {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
}

.loading {
  padding: 28rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
