# 心屿 · 生产反向代理模板（docker-compose prod profile）
#
# 拓扑：客户端 --HTTPS(443)--> nginx --HTTP--> FastAPI(api:8000) --> MongoDB
# 对外契约见 README「API 文档」§15：限流为「Nginx + 应用层」双层执行，
# 本文件承担 IP 维度的第一层；用户维度的 30 条/小时消息限流在应用层。
#
# 占位符在容器启动时由 docker-entrypoint.sh 用环境变量替换后写入
# /etc/nginx/nginx.conf；证书文件缺失时容器直接退出（不降级为明文 HTTP）：
#   __TLS_CERT_PATH__   -> TLS_CERT_PATH   （默认 /etc/nginx/certs/server.crt）
#   __TLS_KEY_PATH__    -> TLS_KEY_PATH    （默认 /etc/nginx/certs/server.key）
#   __TLS_SERVER_NAME__ -> TLS_SERVER_NAME （默认 _，匹配任意 Host）

user nginx;
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # 日志不含敏感信息：不记录请求体与 Authorization 头
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    'rt=$request_time uct=$upstream_connect_time urt=$upstream_response_time';
    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    # gzip：SSE 流式接口必须排除（text/event-stream 不在列表内，天然不压缩）
    gzip on;
    gzip_types application/json text/css application/javascript;
    gzip_min_length 1k;

    # 上传体积上限：对齐后端 ASR 限制（单段录音 ≤ 2MB），留 1MB 头部余量
    client_max_body_size 3m;

    # ---- 第一层限流（IP 维度，README §15）----
    # 登录/刷新：10 次/分钟/IP，防 code 重放与爆破
    limit_req_zone $binary_remote_addr zone=auth_login:10m rate=10r/m;
    # 其余读接口：60 次/分钟/IP（应用层另有 60 次/分钟/用户）
    limit_req_zone $binary_remote_addr zone=api_read:10m rate=60r/m;
    limit_req_status 429;

    upstream xinyu_api {
        server api:8000;
        keepalive 32;
    }

    # ================================================================
    # 80：只做 HTTPS 跳转；/health 保留给编排与外部探活（不含敏感数据）
    # ================================================================
    server {
        listen 80;
        server_name __TLS_SERVER_NAME__;

        location = /health {
            proxy_pass http://xinyu_api;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ================================================================
    # 443：唯一对外业务入口
    # ================================================================
    server {
        listen 443 ssl;
        http2 on;
        server_name __TLS_SERVER_NAME__;

        ssl_certificate     __TLS_CERT_PATH__;
        ssl_certificate_key __TLS_KEY_PATH__;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # 安全响应头（HSTS 仅 HTTPS 下发）
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;

        # 健康检查（编排与外部探活用；不限流）
        location = /health {
            proxy_pass http://xinyu_api;
        }

        # 登录与刷新：严格限流
        location ~ ^/api/v1/auth/(wx-login|refresh)$ {
            limit_req zone=auth_login burst=5 nodelay;
            proxy_pass http://xinyu_api;
        }

        # 消息发送（SSE 流式）：长连接，禁用缓冲，读超时须大于模型硬超时(30s)
        location ~ ^/api/v1/sessions/[^/]+/messages$ {
            proxy_pass http://xinyu_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;          # SSE 增量必须即时下发
            proxy_cache off;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
        }

        # 语音转写上传：体积上限由 client_max_body_size(3m) 兜底
        location = /api/v1/speech/transcribe {
            limit_req zone=api_read burst=10 nodelay;
            proxy_pass http://xinyu_api;
            proxy_read_timeout 30s;       # 对齐 asr_timeout_seconds(15s) + 余量
        }

        # 其余 API：常规限流与超时
        location /api/ {
            limit_req zone=api_read burst=20 nodelay;
            proxy_pass http://xinyu_api;
            proxy_read_timeout 45s;
        }

        # 默认拒绝：除上述路径外一律 404（危机资源等公开接口走 /api/ 前缀）
        location / {
            return 404;
        }

        # 公共反代参数（被各 location 继承；location 内另有 proxy_pass 时仍生效）
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
    }
}
