/* pages/index/index.wxss —— 首页样式（暖暮治愈主题） */
.page {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text);
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

/* 每日一句：屿青浅底，像一小片安静的水面 */
.quote-card {
  background: linear-gradient(135deg, var(--brand-tint), var(--brand-tint2));
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.quote-text {
  font-size: 30rpx;
  color: var(--brand-ink);
  line-height: 1.6;
}

.quote-foot {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--brand-soft);
  text-align: right;
}

/* 记忆型问候：暖木色，制造「被记得」的温度 */
.memory-card {
  display: flex;
  align-items: flex-start;
  background: var(--memory-bg);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.memory-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.memory-text {
  font-size: 28rpx;
  color: var(--memory-text);
  line-height: 1.6;
  flex: 1;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-date {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3);
}

.mood-row {
  display: flex;
  justify-content: space-between;
}

.mood-item {
  width: 120rpx;
  padding: 20rpx 0 16rpx;
  text-align: center;
  background: var(--input-bg);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: transform 0.1s ease;
}

.mood-item--on {
  background: var(--brand-tint);
  border-color: var(--brand);
  transform: translateY(-6rpx);
}

.mood-emoji {
  font-size: 48rpx;
}

.mood-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text);
}

.note-box {
  position: relative;
  margin-top: 24rpx;
}

.note-input {
  width: 100%;
  min-height: 96rpx;
  background: var(--input-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx 44rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.note-ph {
  color: var(--text-3);
}

.note-count {
  position: absolute;
  right: 20rpx;
  bottom: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.submit-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  border-radius: var(--radius-sm);
}

.submit-btn--disabled {
  background: var(--disabled);
}

.done-card {
  display: flex;
  align-items: center;
  background: var(--brand-tint2);
  border-radius: var(--radius-sm);
  padding: 24rpx;
}

.done-emoji {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.done-main {
  flex: 1;
}

.done-line {
  font-size: 30rpx;
  color: var(--text);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* 连续打卡：暖沙橘，鼓励性高光 */
.streak-badge {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--accent-ink);
  background: var(--accent-tint);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

.done-note {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.chat-entry {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.chat-entry-main {
  flex: 1;
}

.chat-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.chat-entry-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.chat-entry-arrow {
  font-size: 40rpx;
  color: var(--text-3);
}
