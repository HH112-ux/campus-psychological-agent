/* pages/logs/logs.wxss —— 情绪日志样式 */
.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.trend-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
  margin-bottom: 24rpx;
}

.trend-head {
  margin-bottom: 28rpx;
}

.streak-badge {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 600;
  color: #d97706;
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 6rpx 18rpx;
}

.streak-badge--dim {
  color: #8f959e;
  background: #f5f7fa;
}

.trend-desc {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #1f2329;
}

.trend-dom {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #646a73;
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  flex: 1;
  width: 48rpx;
  display: flex;
  align-items: flex-end;
  background: #f5f7fa;
  border-radius: 8rpx;
  overflow: hidden;
}

.bar {
  width: 100%;
  background: linear-gradient(180deg, #7fb0ff, #4c8bf5);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 6rpx;
}

.bar--empty {
  background: #eef1f5;
  min-height: 8rpx;
}

.bar-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.chart-legend {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a6adb8;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.chip {
  margin: 0 12rpx 16rpx 0;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #646a73;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.04);
}

.chip--on {
  color: #4c8bf5;
  background: #e8f0fe;
  font-weight: 600;
}

.timeline {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.tl-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.tl-item:last-child {
  border-bottom: none;
}

.tl-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tl-main {
  flex: 1;
  min-width: 0;
}

.tl-head {
  display: flex;
  align-items: baseline;
}

.tl-label {
  font-size: 30rpx;
  font-weight: 600;
}

.tl-int {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #646a73;
}

.tl-time {
  margin-left: auto;
  font-size: 24rpx;
  color: #a6adb8;
}

.tl-src {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8f959e;
}

.tl-evidence {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #1f2329;
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  line-height: 1.5;
}

.empty {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8f959e;
}

.loading {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #a6adb8;
}
