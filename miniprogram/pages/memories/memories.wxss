/* pages/memories/memories.wxss —— 长期记忆（V6），复用 app.wxss 设计令牌 */
.page {
  padding: 32rpx 28rpx 60rpx;
}

.intro {
  font-size: var(--fs-body-s);
  color: var(--text-3);
  line-height: 1.6;
  margin: 8rpx 4rpx 28rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 4rpx 20rpx;
}

.total {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.clear {
  font-size: var(--fs-caption);
  color: var(--danger);
  padding: 8rpx 20rpx;
}

.hint {
  text-align: center;
  color: var(--text-3);
  font-size: var(--fs-body-s);
  padding: 60rpx 0;
}

.group {
  margin-bottom: 28rpx;
}

.group-title {
  font-size: var(--fs-caption);
  color: var(--brand);
  font-weight: 600;
  margin: 0 4rpx 16rpx;
}

.mem {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
}

.mem-content {
  flex: 1;
  font-size: var(--fs-body-s);
  color: var(--text);
  line-height: 1.5;
}

.mem-del {
  margin-left: 20rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: 8rpx 16rpx;
}

/* 空状态：一句具体引导 + 一个可点击的下一步入口，不用 emoji 插画 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: var(--fs-h2);
  color: var(--text);
  font-weight: 600;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  line-height: 1.6;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 48rpx;
  font-size: var(--fs-body-s);
  color: #ffffff;
  background: var(--brand);
  border-radius: 999rpx;
}
