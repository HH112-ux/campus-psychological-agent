# ===== 心屿后端环境变量模板 =====
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁提交。

# 应用
APP_NAME=xinyu-backend
APP_VERSION=0.2.0
# ENV=prod 时启用生产配置启动校验（M5 ⑤）：mock 登录/弱 JWT/缺密钥等将直接拒绝启动
# 模板默认面向部署；本地纯开发请改为 dev，并把 WX_MOCK_LOGIN 改回 true
ENV=prod
DEBUG=false

# MongoDB
# 本地原生 mongod（无认证）可用：MONGODB_URI=mongodb://localhost:27017
# 生产 / docker-compose（开启 --auth）必须使用带凭据的连接串，ENV=prod 时缺少凭据会拒绝启动：
# MONGODB_URI=mongodb://xinyu:change-me-strong-password@mongo:27017/xinyu?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=xinyu
# docker-compose 初始化 Mongo 管理员（与上面的连接串保持一致；不要提交真实密码）
MONGO_ROOT_USERNAME=xinyu
MONGO_ROOT_PASSWORD=change-me-strong-password

# ===== 反向代理 HTTPS（docker-compose prod profile）=====
# 证书与私钥默认放在 backend/nginx/certs/（server.crt / server.key，*.key/*.pem 已 gitignore）
# 也可用下面的变量指定容器内路径；文件缺失时 nginx 容器启动即失败，不会降级为明文 HTTP
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key
# 证书对应的备案域名；单站点部署可保持 _ （匹配任意 Host）
TLS_SERVER_NAME=_

# JWT（P1 启用前必须替换为随机强密钥：openssl rand -hex 32）
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=604800
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# 对话内容加密（P4 启用；密钥与数据库分离托管）
DATA_ENCRYPTION_KEY=
# 密钥版本号（写入密文信封，轮换审计用；默认 v1）
DATA_ENCRYPTION_KEY_ID=v1
# 轮换兜底：新钥生效后把旧钥填这里，旧密文仍可解密；全量重写完成后再清空
DATA_ENCRYPTION_KEY_PREVIOUS=

# 微信小程序（P1 登录）
WX_APPID=wx你的小程序AppID
# AppSecret 仅存服务端。mock 登录默认关闭：开启后所有用户会被映射到同一个固定 openid
# （等于全校共用一个账号）；仅本地联调且无 Secret 时才临时改为 true
WX_SECRET=
WX_MOCK_LOGIN=false
WX_MOCK_OPENID=mock_dev_openid

# 内容安全（M1，提审要求 G9）：用户消息入库前过微信 msgSecCheck
# mock 登录或未配置 AppID/Secret 时自动跳过；生产环境必须为 true
WX_CONTENT_CHECK_ENABLED=true
# 微信服务端接口地址（常量，一般无需修改）
WX_STABLE_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/stable_token
WX_MSG_SEC_CHECK_URL=https://api.weixin.qq.com/wxa/msg_sec_check

# 业务规则（P1）
MESSAGE_MAX_LENGTH=2000
SESSION_ROUND_LIMIT=50
SESSION_CONCURRENCY_LIMIT=5
MEMORY_WINDOW_ROUNDS=20
# 会话详情最多返回的消息条数（防止超长会话一次性拉全量）
SESSION_MESSAGES_MAX_RETURN=200

# 数据留存与清除（M3）：软删恢复期 + 到期物理删除定时任务
# 软删后用户可撤销的天数（期限口径待 M2 与校方确认）
ERASE_RECOVER_DAYS=30
# 生产必须为 true，否则「软删 N 天后物理删除」的合规承诺不兑现
DATA_PURGE_ENABLED=true
# 到期数据扫描间隔（秒），默认每小时一次
DATA_PURGE_INTERVAL_SECONDS=3600

# 智谱开放平台（https://open.bigmodel.cn 申请）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_CHAT=glm-4-air
MODEL_LIGHT=glm-4-flash
# E2 多模型容灾：通义千问备用供应商（OpenAI 兼容接口）
# QWEN_ENABLED=true 且 QWEN_API_KEY 非空时启用，主模型异常自动切备用
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_CHAT=qwen-plus
QWEN_MODEL_LIGHT=qwen-turbo
# E3 模型路由与成本基线（默认关闭路由，保持现有行为不变）
# 短句 + 无危机 + 非负面情绪 → 轻量档；其余走主档（启发式规则，零额外 LLM 调用）
COST_ROUTING_ENABLED=false
COST_ROUTING_LIGHT_MAX_CHARS=30
# 按档位累计调用次数与字符数并输出结构化日志（进程内估算）
COST_TRACKING_ENABLED=true

# 限流与降级
USER_MESSAGE_HOURLY_LIMIT=30
MODEL_TIMEOUT_SECONDS=30.0
# 跨实例共享状态后端（M5/G4）：memory=单机内存（默认/dev）；redis=多实例共享（生产）
# 同时驱动限流、告警冷却与失败率计数；旧名 RATELIMIT_BACKEND 仍兼容可读（勿再用）
SHARED_STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# 情绪分析（P3）：单轮分析硬超时（秒），超过即跳过本轮记录
EMOTION_ANALYSIS_TIMEOUT_SECONDS=5.0

# 监控告警（M5 ③ / M4 值班人通知）：企业微信群机器人 webhook
# 未配置 ALERT_WEBHOOK_URL 时仅记 warning 日志（dev 默认）；告警异常永不阻断主链路
# 隐私红线：告警只含用户/会话 ID、级别与触发源，不含命中词与对话原文
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
# 同一告警的 webhook 冷却时间（秒），防止重复轰炸
ALERT_COOLDOWN_SECONDS=600

# 主动关怀（V3）：连续低落 / 打卡中断 → 次日经微信订阅消息温和问候（用户可随时关闭）
CARING_ENABLED=true
# 连续 N 天负面档位（low/anxious/irritable）触发
CARING_LOW_STREAK_DAYS=3
# 打卡中断 N 天触发
CARING_CHECKIN_GAP_DAYS=2
# 频控：同一用户每周最多发送条数
CARING_MAX_PER_WEEK=2
# 每日扫描/发送时刻（Asia/Shanghai，0–23）
CARING_HOUR=9
# 订阅消息模板 ID（微信公众平台申请）：留空时安全跳过，不影响主链路
WX_SUBSCRIBE_TEMPLATE_ID=
# 模板中承载问候语的字段名（如 thing1）；thing 类型限 20 字符
WX_SUBSCRIBE_FIELD_KEY=thing1

# P5 降级开关：false 时跳过情绪分析（不调模型/不写记录/不发 emotion 事件）
EMOTION_ANALYSIS_ENABLED=true
# P5 降级开关：false 时对话统一走非流式 JSON（弱网/平台异常兜底）
STREAM_ENABLED=true

# 长期记忆（V6）：跨会话记住人物/事件/偏好/情绪诱因，回复时按相关性克制注入
# 记忆内容同样 AES-256-GCM 加密存储；用户可在「我的 → 长期记忆」查看/删除/清空
LONG_MEMORY_ENABLED=true
# 单轮抽取硬超时（秒），超过即跳过本轮（fail-safe，不影响对话主链路）
LONG_MEMORY_EXTRACT_TIMEOUT_SECONDS=8.0
# 单用户记忆条数上限，超出时删除最旧的（最小化留存）
LONG_MEMORY_MAX_ITEMS=100
# 注入上限：每次回复最多带出的相关记忆条数 / 总字数（克制注入，避免喧宾夺主）
LONG_MEMORY_INJECT_MAX_ITEMS=5
LONG_MEMORY_INJECT_MAX_CHARS=200

# 语音入口（V5）：小程序录音 → 转写 → 用户确认后进入对话
# 合规基线：转写后即弃、不落原始音频；提供方未配置时 fail-safe 降级为键盘输入
ASR_ENABLED=true
# mock=本地联调占位（返回固定文本，生产禁用）；http=调用通用 ASR 网关
ASR_PROVIDER=mock
# 通用 ASR 网关：POST 原始音频字节，期望返回 {"text": "..."}（生产必填）
ASR_ENDPOINT_URL=
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=15.0
# 单段录音体积上限（字节，约 2MB；前端同步限录音时长 60s）
ASR_MAX_AUDIO_BYTES=2097152
# mock 提供方固定返回文本（仅本地联调）
ASR_MOCK_TEXT=这是一段语音输入的内容
