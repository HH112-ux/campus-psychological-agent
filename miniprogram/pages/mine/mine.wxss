/* pages/mine/mine.wxss —— 我的样式 */
.page {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #7fb0ff, #4c8bf5);
  color: #ffffff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.5;
}

.cell {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.cell-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.cell-title {
  flex: 1;
  font-size: 30rpx;
  color: #1f2329;
}

.cell-arrow {
  font-size: 36rpx;
  color: #c2c9d4;
}

.group-title {
  font-size: 24rpx;
  color: #8f959e;
  margin: 8rpx 8rpx 16rpx;
}

.hotline {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.03);
}

.hotline-main {
  flex: 1;
}

.hotline-name {
  font-size: 30rpx;
  color: #1f2329;
}

.hotline-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8f959e;
}

.hotline-phone {
  font-size: 30rpx;
  font-weight: 600;
  color: #4c8bf5;
}

.version {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a6adb8;
}
