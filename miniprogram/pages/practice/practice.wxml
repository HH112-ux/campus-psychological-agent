<view class="page">
  <view class="intro">选一个练习，陪自己待一会儿。内容仅供放松与觉察，不替代专业帮助。</view>

  <view class="cards">
    <view
      wx:for="{{practices}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="openCard"
    >
      <view class="card-top">
        <text class="cat">{{item.categoryLabel}}</text>
        <text class="dur">{{item.durationText}}</text>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-sub">{{item.subtitle}}</view>
      <view wx:if="{{item.completed_today}}" class="done-tag">今日已完成</view>
    </view>
  </view>
</view>

<view wx:if="{{active}}" class="mask" bindtap="closeCard">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title">{{active.title}}</view>
      <view class="sheet-sub">{{active.subtitle}}</view>
    </view>

    <view wx:if="{{active.category === 'breathing'}}" class="breath-wrap">
      <view
        class="breath-circle"
        style="transform: scale({{breathScale}}); transition-duration: {{phaseSeconds}}s;"
      >
        <text class="breath-text">{{breathText}}</text>
      </view>
    </view>

    <view wx:elif="{{active.category === 'mindfulness'}}" class="mind-wrap">
      <view
        wx:for="{{active.steps}}"
        wx:key="index"
        class="mind-step {{stepIndex === index ? 'on' : ''}}"
        >{{item}}</view
      >
    </view>

    <view wx:else class="task-wrap">
      <view
        wx:for="{{active.tasks}}"
        wx:key="index"
        class="task {{checked[index] ? 'on' : ''}}"
        data-index="{{index}}"
        bindtap="toggleTask"
      >
        <view class="tick">{{checked[index] ? '✓' : ''}}</view>
        <text class="task-text">{{item}}</text>
      </view>
    </view>

    <view class="timer">{{remainText}}</view>

    <view class="btns">
      <button class="btn-ghost" bindtap="closeCard">稍后再做</button>
      <block wx:if="{{active.category === 'activation'}}">
        <button class="btn-main" bindtap="finish">完成</button>
      </block>
      <block wx:else>
        <button class="btn-main" bindtap="toggleRun">{{running ? '暂停' : '开始'}}</button>
        <button class="btn-ghost" bindtap="finish">完成</button>
      </block>
    </view>
  </view>
</view>
