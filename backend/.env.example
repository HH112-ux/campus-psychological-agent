# ===== 心屿后端环境变量模板 =====
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁提交。

# 应用
APP_NAME=xinyu-backend
APP_VERSION=0.2.0
# ENV=prod 时启用生产配置启动校验（M5 ⑤）：mock 登录/弱 JWT/缺密钥等将直接拒绝启动
ENV=dev
DEBUG=false

# MongoDB（本地原生 mongod 或 docker-compose mongo 服务）
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=xinyu

# JWT（P1 启用前必须替换为随机强密钥：openssl rand -hex 32）
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=604800
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# 对话内容加密（P4 启用；密钥与数据库分离托管）
DATA_ENCRYPTION_KEY=

# 微信小程序（P1 登录）
WX_APPID=wx你的小程序AppID
# AppSecret 仅存服务端；本地开发无 Secret 时保持 WX_MOCK_LOGIN=true 走 mock
WX_SECRET=
WX_MOCK_LOGIN=true
WX_MOCK_OPENID=mock_dev_openid

# 内容安全（M1，提审要求 G9）：用户消息入库前过微信 msgSecCheck
# mock 登录或未配置 AppID/Secret 时自动跳过；生产环境必须为 true
WX_CONTENT_CHECK_ENABLED=true
# 微信服务端接口地址（常量，一般无需修改）
WX_STABLE_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/stable_token
WX_MSG_SEC_CHECK_URL=https://api.weixin.qq.com/wxa/msg_sec_check

# 业务规则（P1）
MESSAGE_MAX_LENGTH=2000
SESSION_ROUND_LIMIT=50
SESSION_CONCURRENCY_LIMIT=5
MEMORY_WINDOW_ROUNDS=20
# 会话详情最多返回的消息条数（防止超长会话一次性拉全量）
SESSION_MESSAGES_MAX_RETURN=200

# 数据留存与清除（M3）：软删恢复期 + 到期物理删除定时任务
# 软删后用户可撤销的天数（期限口径待 M2 与校方确认）
ERASE_RECOVER_DAYS=30
# 生产必须为 true，否则「软删 N 天后物理删除」的合规承诺不兑现
DATA_PURGE_ENABLED=true
# 到期数据扫描间隔（秒），默认每小时一次
DATA_PURGE_INTERVAL_SECONDS=3600

# 智谱开放平台（https://open.bigmodel.cn 申请）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_CHAT=glm-4-air
MODEL_LIGHT=glm-4-flash

# 限流与降级
USER_MESSAGE_HOURLY_LIMIT=30
MODEL_TIMEOUT_SECONDS=30.0
# 限流后端（M5/G4）：memory=单机内存（默认/dev）；redis=多实例共享计数（生产）
RATELIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# 情绪分析（P3）：单轮分析硬超时（秒），超过即跳过本轮记录
EMOTION_ANALYSIS_TIMEOUT_SECONDS=5.0

# 监控告警（M5 ③ / M4 值班人通知）：企业微信群机器人 webhook
# 未配置 ALERT_WEBHOOK_URL 时仅记 warning 日志（dev 默认）；告警异常永不阻断主链路
# 隐私红线：告警只含用户/会话 ID、级别与触发源，不含命中词与对话原文
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
# 同一告警的 webhook 冷却时间（秒），防止重复轰炸
ALERT_COOLDOWN_SECONDS=600

# 主动关怀（V3）：连续低落 / 打卡中断 → 次日经微信订阅消息温和问候（用户可随时关闭）
CARING_ENABLED=true
# 连续 N 天负面档位（low/anxious/irritable）触发
CARING_LOW_STREAK_DAYS=3
# 打卡中断 N 天触发
CARING_CHECKIN_GAP_DAYS=2
# 频控：同一用户每周最多发送条数
CARING_MAX_PER_WEEK=2
# 每日扫描/发送时刻（Asia/Shanghai，0–23）
CARING_HOUR=9
# 订阅消息模板 ID（微信公众平台申请）：留空时安全跳过，不影响主链路
WX_SUBSCRIBE_TEMPLATE_ID=
# 模板中承载问候语的字段名（如 thing1）；thing 类型限 20 字符
WX_SUBSCRIBE_FIELD_KEY=thing1

# P5 降级开关：false 时跳过情绪分析（不调模型/不写记录/不发 emotion 事件）
EMOTION_ANALYSIS_ENABLED=true
# P5 降级开关：false 时对话统一走非流式 JSON（弱网/平台异常兜底）
STREAM_ENABLED=true

# 语音入口（V5）：小程序录音 → 转写 → 用户确认后进入对话
# 合规基线：转写后即弃、不落原始音频；提供方未配置时 fail-safe 降级为键盘输入
ASR_ENABLED=true
# mock=本地联调占位（返回固定文本，生产禁用）；http=调用通用 ASR 网关
ASR_PROVIDER=mock
# 通用 ASR 网关：POST 原始音频字节，期望返回 {"text": "..."}（生产必填）
ASR_ENDPOINT_URL=
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=15.0
# 单段录音体积上限（字节，约 2MB；前端同步限录音时长 60s）
ASR_MAX_AUDIO_BYTES=2097152
# mock 提供方固定返回文本（仅本地联调）
ASR_MOCK_TEXT=这是一段语音输入的内容
