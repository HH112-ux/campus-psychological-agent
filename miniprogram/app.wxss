/* app.wxss —— 全局样式与设计变量
   主题：心屿 · 暖暮治愈
   设计观点：心理陪伴场景需要「安全、温暖、不被评判」的视觉氛围，
   因此放弃通用 SaaS 蓝（#4C8BF5）与冷灰底（#F5F7FA），
   改用暖青绿「屿青」作主色（呼应岛屿/水的自然疗愈意象），
   暖米白作页面底，暖沙橘作鼓励高光。所有语义色（危机/警示/成功）
   保持独立饱和度，不被主色同化。 */

page {
  /* —— 主色 · 屿青（疗愈、沉静、自然） —— */
  --brand: #3e7a69;
  --brand-ink: #2f6355;   /* 深屿青：文字/深底 */
  --brand-soft: #5e9c8a;  /* 浅屿青：装饰渐变 */
  --brand-tint: #eaf3ef;  /* 屿青浅底 */
  --brand-tint2: #f1f8f5;

  /* —— 强调色 · 暖沙橘（连续记录、鼓励、高光） —— */
  --accent: #c97b3d;
  --accent-ink: #9c5722;
  --accent-tint: #fbf0e4;

  /* —— 中性 · 暖白体系 —— */
  --bg: #f7f4ef;          /* 暖米白页面底 */
  --surface: #ffffff;
  --surface-warm: #fdfcfa;
  --input-bg: #f3f0eb;
  --line: #ede9e3;
  --text: #2b2825;
  --text-2: #6b655e;
  --text-3: #7a736b;
  --disabled: #bfd1c9;    /* 禁用态填充 */

  /* 原生 TabBar 读不到 WXSS 变量，配色写在 app.json：
     color=--text-3 / selectedColor=--brand / backgroundColor=--surface-warm，
     改这三个令牌时须同步改 app.json，图标见 assets/tabbar/ */

  /* —— 语义色（安全功能，语义不得被主色同化） —— */
  --danger: #c1342a;
  --danger-tint: #fcebe8;
  --warn: #9c6218;
  --warn-tint: #fdf3e2;
  --success: #2e7d4f;
  --success-tint: #e9f5ee;
  --info: #3d6ad6;
  --info-tint: #e9eefb;

  /* —— 记忆卡 · 暖木色 —— */
  --memory-bg: #fbf4e6;
  --memory-text: #7a6437;

  /* —— 形状（圆角 3 档 + 特例；此外禁用） —— */
  --radius-lg: 28rpx;   /* 大卡片、底部弹层、危机卡 */
  --radius-md: 20rpx;   /* 标准卡片、气泡、输入框 */
  --radius-sm: 12rpx;   /* 小卡、内部色块、情绪项、徽章 */
  /* 特例：圆形 50%（头像/色点）、胶囊 999rpx（按钮/chip）、气泡指向角 8rpx */
  --shadow-card: 0 6rpx 20rpx rgba(63, 58, 50, 0.05);
  --shadow-soft: 0 2rpx 10rpx rgba(63, 58, 50, 0.04);
  --shadow-brand: 0 16rpx 40rpx rgba(62, 122, 105, 0.25);  /* 品牌投影：仅呼吸圆、主按钮等单点强调 */
  --scrim: rgba(47, 42, 36, 0.45);                          /* 弹层遮罩 */

  /* —— 字阶（6 档，此外字号禁用；emoji 字形位为 P1 替换前的过渡例外） —— */
  --fs-display: 40rpx;  /* 页面大标题 / 问候语 */
  --fs-h2: 32rpx;       /* 卡片标题、功能入口标题 */
  --fs-body: 30rpx;     /* 正文、气泡、输入框 */
  --fs-body-s: 28rpx;   /* 次要正文、日签、记忆问候 */
  --fs-caption: 24rpx;  /* 元信息、时间戳、说明 */
  --fs-micro: 22rpx;    /* 角标、图例、字数统计 */

  /* —— 动效时长（3 档；呼吸练习动画为功能例外，不受限） —— */
  --dur-fast: 120ms;    /* 按下 / 选中反馈 */
  --dur-base: 240ms;    /* 卡片出现、弹层 */
  --dur-slow: 400ms;    /* 氛围动效上限 */

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text);
  font-size: var(--fs-body);
}

.container {
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

/* 通用卡片（首页/日志/我的共用外观基线） */
.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
